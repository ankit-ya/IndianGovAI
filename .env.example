# LLM provider: "groq" or "ollama"
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq (free tier key from https://console.groq.com/keys)
GROQ_API_KEY=

# Model name per provider
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# Embedding / reranker models (local, no key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Qdrant: leave QDRANT_URL empty to use local on-disk mode at QDRANT_PATH
QDRANT_URL=
QDRANT_PATH=./qdrant_local
QDRANT_COLLECTION=govschemes

# Optional: LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=indian-gov-rag
